+  switch (platform) {
+    case 'wechat':
+      return themePresets
+    case 'xiaohongshu':
+      return getXiaohongshuPresets()
     case 'zhihu':
-      return convertToZhihu(html)
-    default:
-      return html
+      return getZhihuPresets()
+    default: {
+      const _exhaustiveCheck: never = platform
+      throw new Error(`未支持的平台: ${_exhaustiveCheck}`)
+    }
   }
 }

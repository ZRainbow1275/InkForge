# InkForge 环境变量配置示例
# 复制此文件为 .env.local 并根据需要修改

# ═══════════════════════════════════════════════════════════════════
# CORS 代理配置（必需 - 开发和生产环境均需配置）
# ═══════════════════════════════════════════════════════════════════
#
# [!] 安全警告：公共 CORS 代理已被移除
#     公共代理（api.allorigins.win, corsproxy.io）存在严重安全风险：
#     - 隐私泄露：请求 URL 被第三方服务器记录
#     - 中间人攻击：代理服务可能注入恶意内容
#     - 数据篡改：返回内容可能被修改
#
# ═══════════════════════════════════════════════════════════════════
# 方案1: 使用 Vite 本地代理（推荐开发环境使用）
# ═══════════════════════════════════════════════════════════════════
# 已在 vite.config.ts 中配置 /api/cors-proxy 路由
# 使用方法：设置以下环境变量
# VITE_CORS_PROXY_URL=http://localhost:3005/api/cors-proxy?url=
#
# ═══════════════════════════════════════════════════════════════════
# 方案2: 本地部署 cors-anywhere
# ═══════════════════════════════════════════════════════════════════
# 安装: npm install -g cors-anywhere
# 运行: cors-anywhere --port 8080
# 配置: VITE_CORS_PROXY_URL=http://localhost:8080/
#
# ═══════════════════════════════════════════════════════════════════
# 方案3: 自建 CORS 代理服务（推荐生产环境使用）
# ═══════════════════════════════════════════════════════════════════
# 部署自己的代理服务（如 Cloudflare Workers、Vercel Edge Functions）
# 必须使用 HTTPS 协议
# 示例: https://your-proxy.example.com/fetch?url=
#
VITE_CORS_PROXY_URL=

# ═══════════════════════════════════════════════════════════════════
# AI 服务配置（Ollama）
# ═══════════════════════════════════════════════════════════════════

# Ollama API 地址（默认: http://localhost:11434）
VITE_OLLAMA_URL=http://localhost:11434

# 默认模型（默认: qwen2.5:7b）
VITE_OLLAMA_MODEL=qwen2.5:7b

# AI 状态检查超时（毫秒，默认: 3000）
VITE_AI_STATUS_TIMEOUT=3000

# AI 生成请求超时（毫秒，默认: 60000）
VITE_AI_GENERATE_TIMEOUT=60000

# 请求节流间隔（毫秒，默认: 1000）
VITE_AI_THROTTLE_INTERVAL=1000

# 最大输入内容长度（字符，默认: 10000）
VITE_AI_MAX_INPUT_LENGTH=10000

# ═══════════════════════════════════════════════════════════════════
# 解析器配置
# ═══════════════════════════════════════════════════════════════════

# 解析请求超时（毫秒，默认: 10000）
VITE_PARSE_TIMEOUT=10000

# 最大重试次数（默认: 3）
VITE_PARSE_MAX_RETRIES=3

# 描述截断最大长度（默认: 200）
VITE_PARSE_MAX_DESCRIPTION=200

# 内容截断最大长度（默认: 3000）
VITE_PARSE_MAX_CONTENT=3000

# ═══════════════════════════════════════════════════════════════════
# 日志配置
# ═══════════════════════════════════════════════════════════════════

# 日志级别（debug, info, warn, error）
# 生产环境默认 warn，开发环境默认 debug
VITE_LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════════════
# 微信公众号测试号发布（仅 Tauri / 本地服务端边界读取，不要使用 VITE_ 前缀）
# ═══════════════════════════════════════════════════════════════════
#
# 复制到 inkforge/.env.local 后填写测试号凭据。
# 这些变量只应由 Tauri Rust 命令读取，前端不要直接暴露。
#
WECHAT_APP_ID=
WECHAT_APP_SECRET=

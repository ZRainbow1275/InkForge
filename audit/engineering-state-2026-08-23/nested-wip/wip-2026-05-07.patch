+  { flush: 'sync' },
+)
+
+watch(
+  managerTab,
+  () => scheduleLayoutPersistenceSave(),
+  { flush: 'sync' },
+)
+
+watch(
+  selectedArticleId,
+  () => scheduleLayoutPersistenceSave(),
+  { flush: 'post' },
+)
+
+watch(

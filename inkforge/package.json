{
  "name": "inkforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:perf": "vite --host 127.0.0.1 --mode performance",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.vue --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "wdio run tests/e2e/wdio.conf.cjs",
    "style-proof:release-preflight": "tsx scripts/style-proof-release-preflight.ts",
    "style-proof:application-preflight": "tsx scripts/style-proof-release-preflight.ts --scope=application",
    "style-proof:application-acceptance": "tsx scripts/style-proof-application-acceptance.ts",
    "style-proof:current-round": "tsx scripts/style-proof-application-acceptance.ts --json",
    "style-proof:application-gallery": "tsx scripts/style-proof-application-gallery.ts",
    "style-proof:wechat-style-samples": "tsx scripts/style-proof-wechat-style-samples.ts",
    "style-proof:external-handoff": "tsx scripts/style-proof-external-handoff.ts",
    "style-proof:wechat-manual-checklist": "tsx scripts/style-proof-external-handoff.ts --checklist --platform=wechat --next-only --handoff-ok-exit-zero",
    "style-proof:wechat-manual-handoff": "tsx scripts/style-proof-external-handoff.ts --template --platform=wechat --next-only --handoff-ok-exit-zero",
    "style-proof:wechat-manual-manifest-drafts": "tsx scripts/style-proof-external-handoff.ts --manifest-drafts --platform=wechat --next-only --handoff-ok-exit-zero",
    "style-proof:manifest-intake": "tsx scripts/style-proof-manifest-intake.ts",
    "style-proof:manifest-merge": "tsx scripts/style-proof-manifest-merge.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-character-count": "^2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-dropcursor": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-list-item": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "@types/dompurify": "^3.0.5",
    "codemirror": "^6.0.2",
    "dexie": "^4.0.10",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "juice": "^11.0.0",
    "katex": "^0.16.45",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.12",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "pinia": "^2.2.8",
    "vue": "^3.5.13",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.6.4",
    "zod": "^4.2.1"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "^2.27.2",
      "@tiptap/pm": "^2.27.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/cli": "^1.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@wdio/cli": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "autoprefixer": "^10.4.20",
    "chai": "^6.2.2",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.10",
    "webdriverio": "^9.27.2"
  }
}

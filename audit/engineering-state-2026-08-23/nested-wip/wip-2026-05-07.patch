+          if (existingStyle) {
+            const mergedAttrs = attrs.replace(
+              /style="([^"]*)"/,
+              `style="$1;${techStyle}"`
+            )
+            return `<h2${mergedAttrs}>${content}</h2>`
+          }
+          return `<h2${attrs} style="${techStyle}">${content}</h2>`
+        }
+      )
+      break

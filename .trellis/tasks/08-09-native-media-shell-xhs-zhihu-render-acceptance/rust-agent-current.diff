+    let mut access_token = fetch_access_token(client, config)
+        .await
+        .map_err(|_| "access-token-failed".to_string())?;
+
+    for attempt in 0..2 {
+        let response = client
+            .post(build_wechat_url(path, &[("access_token", &access_token)])?)

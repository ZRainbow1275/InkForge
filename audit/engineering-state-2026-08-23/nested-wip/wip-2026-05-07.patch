+  const anchor = document.createElement('a')
+  anchor.href = url
+  anchor.download = buildDownloadFileName(publishTitle.value)
+  document.body.appendChild(anchor)
+  anchor.click()
+  anchor.remove()
+  URL.revokeObjectURL(url)
+  showToastMessage('HTML 文件已生成并下载')

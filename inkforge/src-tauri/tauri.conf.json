{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 3005",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:3005",
    "distDir": "../dist"
  },
  "package": {
    "productName": "InkForge",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true,
        "exists": true,
        "scope": [
          "$DOCUMENT/*",
          "$DOWNLOAD/*",
          "$APPDATA/*"
        ]
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "clipboard": {
        "all": true,
        "writeText": true,
        "readText": true
      },
      "shell": {
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://localhost:11434/*"
        ]
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "Copyright 2024 InkForge",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "io.inkforge.app",
      "longDescription": "InkForge - 微信公众号排版编辑器，支持本地 AI 辅助写作",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "微信公众号排版编辑器",
      "targets": [
        "msi",
        "dmg",
        "app"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:11434; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "InkForge",
        "width": 1400,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "label": "main",
        "fileDropEnabled": true
      }
    ]
  }
}
